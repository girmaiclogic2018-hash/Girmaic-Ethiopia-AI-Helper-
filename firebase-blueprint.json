{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account schema stored in Firestore containing regional and language settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID generated by Firebase Authentication" },
        "fullName": { "type": "string", "description": "Full name of the developer/user" },
        "email": { "type": "string", "format": "email", "description": "Email address of the user" },
        "phone": { "type": "string", "description": "Ethiopian mobile number prefix (+251)" },
        "language": { "type": "string", "enum": ["am", "om", "so", "ti", "en"], "description": "Default language code" },
        "preferredWoreda": { "type": "string", "description": "Local woreda name for tailored crop reports" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when user signed up" }
      },
      "required": ["uid", "fullName", "email", "language"]
    },
    "CvDraft": {
      "title": "CvDraft",
      "description": "A dynamic CV document built by the AI CV Builder tool for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique document ID" },
        "uid": { "type": "string", "description": "Reference UID from Firebase auth" },
        "fullName": { "type": "string", "description": "Full name on CV header" },
        "professionalTitle": { "type": "string", "description": "E.g., Software Developer or Agronomist" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email on the CV" },
        "education": { "type": "string", "description": "University degree and honors" },
        "skills": { "type": "string", "description": "Comma separated stack list" },
        "experience": { "type": "string", "description": "Prior jobs description" },
        "aiOptimizedCopy": { "type": "string", "description": "The Gemini-enhanced professional summary" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "uid", "fullName", "education", "experience"]
    },
    "QuizProgress": {
      "title": "QuizProgress",
      "description": "Educational progress tracker for high school prep and skills assessment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "lessonTopic": { "type": "string" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "lessonTopic", "score", "totalQuestions"]
    },
    "CropReport": {
      "title": "CropReport",
      "description": "Diagnostic or fertilizer recommendation reports logged by the farmer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "cropType": { "type": "string", "enum": ["Teff", "Wheat", "Maize", "Barley"] },
        "areaHectares": { "type": "number" },
        "soilType": { "type": "string" },
        "calculatedUreaKg": { "type": "number" },
        "calculatedNpsKg": { "type": "number" },
        "pestsAdvice": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "cropType", "areaHectares", "calculatedUreaKg", "calculatedNpsKg"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Secure primary user profiles. Users can only read and write their own documents."
    },
    "/users/{uid}/cvs/{cvId}": {
      "schema": "CvDraft",
      "description": "User generated resumes optimized by Gemini."
    },
    "/users/{uid}/quizzes/{quizId}": {
      "schema": "QuizProgress",
      "description": "Assessment history tracking for Ethiopian national exams."
    },
    "/users/{uid}/crops/{reportId}": {
      "schema": "CropReport",
      "description": "Soil analysis and crop diagnostics for local farmers."
    }
  }
}
